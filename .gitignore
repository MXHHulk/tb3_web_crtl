# Python 編譯快取
__pycache__/
*.pyc
*.pyo

# catkin 建置產物
build/
devel/

# 執行日誌
*.log

# 車上產生的地圖與紀錄（本地備份在 experiments/robot/，由 tools/pull_from_robot.sh 拉回）
turtlebot3_ccpp/maps/
turtlebot3_ccpp/data/

# 文件產出成品（Word / PowerPoint）：由 docs/**/gen_*.py 產生，不進版控
docs/**/*.docx
docs/**/*.pptx
# 大型實驗檔與影片素材（放雲端硬碟，不進版控）
*.bag
media/

# Claude Code 本機設定與技能（含 94 MB 技能包）
.claude/
